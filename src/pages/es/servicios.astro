---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PricingCard from '../../components/ui/PricingCard.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { plansEs, maintenanceEs } from '../../data/plans';

const nav = routes.es;
const checkIcon = 'm4.5 12.75 6 6 9-13.5';

const faqs = [
	{ q: '¿Qué plan me conviene?', a: 'Si estás partiendo y necesitas algo simple, el Plan Básico es suficiente. Si quieres mostrar varios servicios, tener formulario de contacto y algo de SEO, el Plan Pro es la mejor opción.' },
	{ q: '¿Puedo cambiar de plan más adelante?', a: 'Sí, se puede ampliar un Plan Básico a Plan Pro más adelante; conversamos el alcance y el costo adicional según lo ya construido.' },
	{ q: '¿La mantención mensual es obligatoria?', a: 'No. El hosting del primer año ya está incluido en ambos planes; la mantención mensual es opcional para quienes prefieren no preocuparse de backups, actualizaciones y cambios de contenido.' },
	{ q: '¿Cómo se realiza el pago?', a: '[PENDIENTE DE REVISIÓN] La modalidad de pago se define directamente contigo antes de comenzar el proyecto.' },
];
---

<Layout
	lang="es"
	route="services"
	title="Servicios"
	description="Planes de desarrollo web para pymes en Chile: sitio básico, sitio profesional y mantención mensual."
>
	<section class="mx-auto max-w-6xl px-6 py-16 text-center sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Planes claros, sin letra chica
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Servicios</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
			Planes pensados para pequeñas y medianas empresas que necesitan una
			presencia web sólida, sin complicaciones. Elige el que se ajusta a
			dónde está tu negocio hoy.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-8">
		<div class="grid gap-8 sm:grid-cols-2">
			{
				plansEs.map((plan) => (
					<PricingCard
						name={plan.name}
						subtitle={plan.subtitle}
						forWhom={plan.forWhom}
						features={plan.features}
						delivery={plan.delivery}
						highlight={plan.highlight}
						highlightLabel="Más elegido"
						ctaLabel="Solicitar este plan"
						ctaHref={nav.contact}
					/>
				))
			}
		</div>

		<article class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{maintenanceEs.name}</h2>
			<p class="mt-1 text-sm text-slate-500">{maintenanceEs.forWhom}</p>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					maintenanceEs.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-slate-700">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
								<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>
			<a href={nav.contact} class="mt-6 inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-brand-300 hover:bg-white hover:text-brand-700">
				Consultar por mantención
			</a>
		</article>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16">
		<blockquote class="rounded-2xl border-l-4 border-brand-600 bg-brand-50/60 p-8 text-lg leading-relaxed text-slate-700">
			<p>
				Un sitio que funciona bien, sin complicaciones. Me tomo en serio los
				detalles que muchos pasan por alto: que tu página cargue rápido, se vea
				bien en el celular y esté construida con buenas prácticas de seguridad
				desde el primer día. No prometo magia — prometo un trabajo bien hecho,
				pensado para que tu negocio tenga una presencia online sólida y sin
				dolores de cabeza.
			</p>
		</blockquote>
	</section>

	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
			<SectionHeader eyebrow="Preguntas frecuentes" title="Dudas sobre los planes" />
			<div class="mt-12 space-y-3">
				{faqs.map((faq) => <FAQItem question={faq.q} answer={faq.a} />)}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<CTASection
			title="¿Conversamos sobre tu proyecto?"
			subtitle="Cuéntame qué necesitas y te ayudo a elegir el plan adecuado."
			primaryLabel="Solicitar cotización"
			primaryHref={nav.contact}
			secondaryLabel="Volver al inicio"
			secondaryHref={nav.home}
		/>
	</section>
</Layout>
