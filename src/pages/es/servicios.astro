---
import Layout from '../../layouts/Layout.astro';

const checkIcon = 'm4.5 12.75 6 6 9-13.5';

const plans = [
	{
		name: 'Plan Básico',
		subtitle: 'Presencia Digital',
		features: [
			'Sitio de una página, responsive',
			'Botón de WhatsApp',
			'Integración con Google Maps',
			'HTTPS y hosting del primer año incluido',
		],
		delivery: 'Entrega en 5-7 días hábiles',
	},
	{
		name: 'Plan Pro',
		subtitle: 'Presencia Profesional',
		features: [
			'Hasta 5 páginas',
			'Formulario de contacto protegido contra spam',
			'SEO básico',
			'Integración con Google Business Profile',
			'HTTPS y hosting del primer año incluido',
		],
		delivery: 'Entrega en 10-15 días hábiles',
		highlight: true,
	},
];

const maintenance = {
	name: 'Mantención Mensual',
	features: [
		'Hosting y dominio administrados',
		'Backups periódicos',
		'Actualizaciones de seguridad',
		'Hasta 2 cambios de contenido al mes',
		'Monitoreo de disponibilidad',
	],
};
---

<Layout
	lang="es"
	route="services"
	title="Servicios"
	description="Planes de desarrollo web para pymes en Chile: sitio básico, sitio profesional y mantención mensual."
>
	<section class="mx-auto max-w-6xl px-6 py-16 text-center sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Planes claros, sin letra chica
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Servicios</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
			Planes pensados para pequeñas y medianas empresas que necesitan una
			presencia web sólida, sin complicaciones.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-8">
		<div class="grid gap-8 sm:grid-cols-2">
			{
				plans.map((plan) => (
					<article
						class:list={[
							'relative flex flex-col rounded-2xl border p-8',
							plan.highlight
								? 'border-brand-600 bg-white shadow-xl shadow-brand-600/10 ring-1 ring-brand-600'
								: 'border-slate-200 bg-white shadow-sm',
						]}
					>
						{plan.highlight && (
							<span class="absolute -top-3 left-8 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
								Más elegido
							</span>
						)}
						<h2 class="text-xl font-bold text-slate-900">{plan.name}</h2>
						<p class="mt-1 text-sm font-medium text-brand-600">{plan.subtitle}</p>

						<ul class="mt-6 flex-1 space-y-3">
							{plan.features.map((feature) => (
								<li class="flex items-start gap-2.5 text-sm text-slate-700">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
										<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
									</svg>
									{feature}
								</li>
							))}
						</ul>

						<p class="mt-6 border-t border-slate-100 pt-4 text-sm font-semibold text-slate-900">
							{plan.delivery}
						</p>
					</article>
				))
			}
		</div>

		<article class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{maintenance.name}</h2>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					maintenance.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-slate-700">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
								<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>
		</article>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16">
		<blockquote class="rounded-2xl border-l-4 border-brand-600 bg-brand-50/60 p-8 text-lg leading-relaxed text-slate-700">
			<p>
				Un sitio que funciona bien, sin complicaciones. Me tomo en serio los
				detalles que muchos pasan por alto: que tu página cargue rápido, se vea
				bien en el celular y esté construida con buenas prácticas de seguridad
				desde el primer día. No prometo magia — prometo un trabajo bien hecho,
				pensado para que tu negocio tenga una presencia online sólida y sin
				dolores de cabeza.
			</p>
		</blockquote>
	</section>
</Layout>
