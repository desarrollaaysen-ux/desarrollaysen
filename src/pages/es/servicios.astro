---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PricingCard from '../../components/ui/PricingCard.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { plansEs, maintenanceEs } from '../../data/plans';

const nav = routes.es;
const checkIcon = 'm4.5 12.75 6 6 9-13.5';

const faqs = [
	{ q: '¿Qué plan me conviene?', a: 'Si estás comenzando y necesitas algo simple, el Plan Básico es suficiente. Si quieres mostrar varios servicios, tener formulario de contacto y algo de SEO, el Plan Pro es la mejor opción.' },
	{ q: '¿Puedo cambiar de plan más adelante?', a: 'Sí, se puede ampliar un Plan Básico a Plan Pro más adelante; conversamos el alcance y el costo adicional según lo ya construido.' },
	{ q: '¿El mantenimiento mensual es obligatorio?', a: 'No. El hosting administrado del primer año ya está incluido en ambos planes; el mantenimiento mensual es opcional para quienes prefieren no preocuparse de respaldos, actualizaciones y cambios de contenido.' },
	{ q: '¿Cuánto cuesta cada plan?', a: `El ${plansEs[0].name} comienza ${plansEs[0].price.toLowerCase()}, el ${plansEs[1].name} ${plansEs[1].price.toLowerCase()} y el ${maintenanceEs.name.toLowerCase()} ${maintenanceEs.price.toLowerCase()}. El valor final depende del alcance, el contenido, las funcionalidades y las integraciones requeridas.` },
	{ q: '¿Cómo se realiza el pago?', a: 'Cada proyecto se cotiza de manera personalizada de acuerdo con su alcance, funcionalidades y plazo. Una vez aprobada la propuesta, se solicita un anticipo para reservar el proyecto e iniciar el trabajo. El saldo restante se paga según las etapas establecidas en la cotización. Los medios de pago disponibles pueden incluir transferencia bancaria y pago electrónico.' },
];
---

<Layout
	lang="es"
	route="services"
	title="Planes de Desarrollo Web para Pymes"
	description="Planes de desarrollo web para pymes en Chile: sitio básico, sitio profesional y mantenimiento mensual."
>
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,var(--color-brand-100),transparent_60%)]"></div>
		<div class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-28">
			<span class="animate-fade-up inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
				Planes claros, sin letra chica
			</span>
			<h1 class="animate-fade-up mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl" style="animation-delay:60ms">
				Servicios
			</h1>
			<p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg text-slate-600" style="animation-delay:120ms">
				Planes pensados para pequeñas y medianas empresas que necesitan una
				presencia web sólida, sin complicaciones. Elige el que se ajusta a
				dónde está tu negocio hoy.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-8">
		<div class="grid gap-8 sm:grid-cols-2">
			{
				plansEs.map((plan) => (
					<PricingCard
						name={plan.name}
						subtitle={plan.subtitle}
						price={plan.price}
						forWhom={plan.forWhom}
						features={plan.features}
						delivery={plan.delivery}
						highlight={plan.highlight}
						highlightLabel="Más elegido"
						ctaLabel="Solicitar este plan"
						ctaHref={nav.contact}
					/>
				))
			}
		</div>

		<p class="mx-auto mt-6 max-w-4xl text-center text-sm text-slate-500">
			El cliente proporciona los textos, imágenes, logotipo y datos comerciales necesarios para el proyecto.
		</p>

		<article class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{maintenanceEs.name}</h2>
			<p class="mt-1 text-xl font-extrabold text-slate-900">{maintenanceEs.price}</p>
			<p class="mt-1 text-sm text-slate-500">{maintenanceEs.forWhom}</p>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					maintenanceEs.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-slate-700">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
								<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>
			<a href={nav.contact} class="mt-6 inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-brand-300 hover:bg-white hover:text-brand-700">
				Consultar por mantenimiento
			</a>
		</article>

		<p class="mx-auto mt-8 max-w-4xl text-center text-sm text-slate-500">
			El valor final depende del alcance, la cantidad de contenido, las funcionalidades y las integraciones necesarias. Los proyectos con requisitos especiales se cotizan de manera personalizada.
		</p>
	</section>

	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
			<blockquote class="rounded-2xl border-l-4 border-brand-600 bg-white p-8 text-lg leading-relaxed text-slate-700 shadow-sm">
				<p>
					Un sitio que funciona bien, sin complicaciones. En Desarrolla Aysén nos
					tomamos en serio los detalles que muchos pasan por alto: que tu página
					cargue rápido, se vea bien en el celular y esté construida con buenas
					prácticas de seguridad desde el primer día. No prometemos magia —
					prometemos un trabajo bien hecho, pensado para que tu negocio tenga una
					presencia online sólida y sin dolores de cabeza.
				</p>
			</blockquote>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<SectionHeader eyebrow="Preguntas frecuentes" title="Dudas sobre los planes" />
		<div class="mt-12 space-y-3">
			{faqs.map((faq) => <FAQItem question={faq.q} answer={faq.a} />)}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<CTASection
			title="¿Conversamos sobre tu proyecto?"
			subtitle="Cuéntanos qué necesitas y te ayudamos a elegir el plan adecuado."
			primaryLabel="Solicitar cotización"
			primaryHref={nav.contact}
			secondaryLabel="Volver al inicio"
			secondaryHref={nav.home}
		/>
	</section>
</Layout>
