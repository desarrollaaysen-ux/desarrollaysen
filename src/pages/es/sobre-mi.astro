---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import CTASection from '../../components/ui/CTASection.astro';

const nav = routes.es;

const values = [
	{ icon: 'M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.2-3.6A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z', title: 'Comunicación clara', text: 'Conversamos contigo en un lenguaje simple, sin tecnicismos innecesarios, en cada etapa del proyecto.' },
	{ icon: 'm4.5 12.75 6 6 9-13.5', title: 'Atención cercana', text: 'Acompañamos cada proyecto de principio a fin, manteniéndote al tanto del avance.' },
	{ icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z', title: 'Buenas prácticas técnicas', text: 'Los proyectos se desarrollan considerando buenas prácticas de seguridad, rendimiento y privacidad.' },
];

const services = [
	'Desarrollo de sitios web profesionales',
	'Páginas para pymes y emprendimientos',
	'Landing pages',
	'Sitios corporativos',
	'Portafolios digitales',
	'Catálogos de productos o servicios',
];
---

<Layout
	lang="es"
	route="about"
	title="Quiénes somos"
	description="Conoce a Desarrolla Aysén: desarrollo de sitios web para pymes y emprendimientos en Chile."
>
	<section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Quiénes somos
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Desarrolla Aysén</h1>

		<div class="mt-8 space-y-5 text-lg text-slate-600">
			<p>
				En Desarrolla Aysén ayudamos a pymes, emprendimientos y pequeños
				negocios a fortalecer su presencia digital mediante sitios web
				modernos, rápidos y adaptados a sus objetivos.
			</p>
			<p>
				Nuestro enfoque combina diseño, tecnología y acompañamiento cercano
				para crear páginas claras, funcionales y fáciles de utilizar,
				pensadas para transmitir confianza y facilitar el contacto con
				nuevos clientes.
			</p>
		</div>

		<div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">Cómo trabajamos</h2>
			<p class="mt-4 text-slate-600">
				Desarrolla Aysén nace con el propósito de acercar soluciones
				digitales profesionales a empresas y emprendimientos que necesitan
				mejorar su presencia en internet. Trabajamos en el desarrollo de
				sitios web rápidos, modernos y funcionales, considerando las
				características de cada negocio y sus objetivos comerciales.
			</p>
			<p class="mt-4 text-slate-600">
				Creemos en un servicio claro, directo y cercano, donde cada cliente
				pueda entender el proceso, participar en las decisiones y recibir una
				solución adaptada a sus necesidades.
			</p>
		</div>

		<div class="mt-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">Qué hacemos</h2>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2">
				{services.map((service) => (
					<li class="flex items-start gap-2.5 text-sm text-slate-700">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
							<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
						</svg>
						{service}
					</li>
				))}
			</ul>
		</div>

		<div class="mt-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">Nuestros valores</h2>
			<div class="mt-8 grid gap-6 sm:grid-cols-3">
				{values.map((value) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
							</svg>
						</div>
						<h3 class="mt-4 text-base font-semibold text-slate-900">{value.title}</h3>
						<p class="mt-2 text-sm text-slate-600">{value.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
		<CTASection
			title="¿Conversamos sobre tu proyecto?"
			subtitle="Cuéntanos en qué está tu negocio y qué te gustaría lograr con tu sitio web."
			primaryLabel="Contactar"
			primaryHref={nav.contact}
			secondaryLabel="Ver servicios"
			secondaryHref={nav.services}
		/>
	</section>
</Layout>
