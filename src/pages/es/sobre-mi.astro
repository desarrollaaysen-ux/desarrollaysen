---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import IconWrapper from '../../components/ui/IconWrapper.astro';
import ProcessStep from '../../components/ui/ProcessStep.astro';
import CTASection from '../../components/ui/CTASection.astro';

const nav = routes.es;

// Conceptos clave que resumen visualmente la identidad de la marca (sin
// cifras ni datos inventados, solo etiquetas descriptivas).
const concepts = [
	{ icon: 'M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 0-6.23-.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5', label: 'Diseño' },
	{ icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5', label: 'Desarrollo' },
	{ icon: 'm4.5 12.75 6 6 9-13.5', label: 'Cercanía' },
	{ icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z', label: 'Buenas prácticas' },
];

const services = [
	{ icon: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm0 4h14', title: 'Desarrollo de sitios web profesionales' },
	{ icon: 'M9 3h6a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm3 15h.01', title: 'Páginas para pymes y emprendimientos' },
	{ icon: 'M13 3 4 14h6l-1 7 9-11h-6l1-7Z', title: 'Landing pages' },
	{ icon: 'M12 3 2 8l10 5 10-5-10-5ZM2 12l10 5 10-5M2 16l10 5 10-5', title: 'Sitios corporativos' },
	{ icon: 'M3 5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25v13.5A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75V5.25Z', title: 'Portafolios digitales' },
	{ icon: 'M4 6h16M4 12h16M4 18h7', title: 'Catálogos de productos o servicios' },
];

// Mismo proceso ya publicado en Inicio: se reutiliza tal cual, sin agregar
// plazos ni garantías nuevas.
const process = [
	{ title: 'Conversación inicial', text: 'Conversamos sobre tu negocio, qué necesita y qué objetivos debe cumplir el sitio.' },
	{ title: 'Definición de necesidades', text: 'Definimos alcance, contenidos y el plan que mejor se ajusta a ti.' },
	{ title: 'Diseño y desarrollo', text: 'Construimos tu sitio con un diseño moderno y buenas prácticas técnicas.' },
	{ title: 'Revisión', text: 'Revisamos juntos el resultado y ajustamos lo que sea necesario.' },
	{ title: 'Publicación', text: 'Tu sitio queda publicado, con HTTPS incluido y el dominio y hosting configurados a tu nombre.' },
	{ title: 'Soporte', text: 'Continuamos disponibles para dudas y, si lo necesitas, seguimos con el mantenimiento mensual.' },
];

const values = [
	{ icon: 'M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.2-3.6A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z', title: 'Comunicación clara', text: 'Conversamos contigo en un lenguaje simple, sin tecnicismos innecesarios, en cada etapa del proyecto.' },
	{ icon: 'm4.5 12.75 6 6 9-13.5', title: 'Atención cercana', text: 'Acompañamos cada proyecto de principio a fin, manteniéndote al tanto del avance.' },
	{ icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z', title: 'Buenas prácticas técnicas', text: 'Los proyectos se desarrollan considerando buenas prácticas de seguridad, rendimiento y privacidad.' },
];
---

<Layout
	lang="es"
	route="about"
	title="Quiénes Somos - Desarrollo Web en Chile"
	description="Conoce a Desarrolla Aysén: desarrollo de sitios web para pymes y emprendimientos en Chile."
>
	<!-- Encabezado -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,var(--color-brand-100),transparent_60%)]"></div>
		<div class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-28">
			<span class="animate-fade-up inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
				Conócenos
			</span>
			<h1 class="animate-fade-up mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl" style="animation-delay:60ms">
				Desarrolla Aysén
			</h1>
			<p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg text-slate-600" style="animation-delay:120ms">
				Ayudamos a pymes, emprendimientos y pequeños negocios a fortalecer su
				presencia digital mediante sitios web modernos, rápidos y adaptados a
				sus objetivos.
			</p>
		</div>
	</section>

	<!-- Quiénes somos -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
					Nuestra identidad
				</span>
				<h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Quiénes somos</h2>
				<div class="mt-6 space-y-5 text-lg text-slate-600">
					<p>
						Nuestro enfoque combina diseño, tecnología y acompañamiento cercano
						para crear páginas claras, funcionales y fáciles de utilizar,
						pensadas para transmitir confianza y facilitar el contacto con
						nuevos clientes.
					</p>
					<p>
						Desarrolla Aysén nace con el propósito de acercar soluciones
						digitales profesionales a empresas y emprendimientos que necesitan
						mejorar su presencia en internet. Trabajamos en el desarrollo de
						sitios web rápidos, modernos y funcionales, considerando las
						características de cada negocio y sus objetivos comerciales.
					</p>
					<p>
						Creemos en un servicio claro, directo y cercano, donde cada cliente
						pueda entender el proceso, participar en las decisiones y recibir
						una solución adaptada a sus necesidades.
					</p>
				</div>
			</div>

			<!-- Bloque visual con conceptos clave (decorativo, sin cifras). -->
			<div class="relative mx-auto w-full max-w-sm">
				<div class="grid grid-cols-2 gap-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
					{concepts.map((concept) => (
						<div class="flex flex-col items-center gap-3 rounded-2xl bg-slate-50 p-5 text-center">
							<IconWrapper path={concept.icon} />
							<span class="text-sm font-semibold text-slate-800">{concept.label}</span>
						</div>
					))}
				</div>
				<div class="absolute -bottom-6 -right-6 -z-10 h-32 w-32 rounded-3xl bg-brand-200/50 blur-2xl"></div>
			</div>
		</div>
	</section>

	<!-- Qué hacemos -->
	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<SectionHeader eyebrow="Qué hacemos" title="En qué podemos ayudarte" subtitle="Soluciones web pensadas para pymes y emprendedores." />
			<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{services.map((service) => (
					<div class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
						<IconWrapper path={service.icon} />
						<span class="text-sm font-semibold text-slate-800">{service.title}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Cómo trabajamos -->
	<section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
		<SectionHeader eyebrow="Cómo trabajamos" title="Un proceso ordenado, de principio a fin" align="left" />
		<div class="mt-12">
			{process.map((step, i) => (
				<ProcessStep number={i + 1} title={step.title} text={step.text} isLast={i === process.length - 1} />
			))}
		</div>
	</section>

	<!-- Nuestros valores -->
	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
			<SectionHeader eyebrow="Nuestros valores" title="Lo que guía cada proyecto" />
			<div class="mt-12 grid gap-6 sm:grid-cols-3">
				{values.map((value) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
						<IconWrapper path={value.icon} />
						<h3 class="mt-4 text-base font-semibold text-slate-900">{value.title}</h3>
						<p class="mt-2 text-sm text-slate-600">{value.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<CTASection
			title="¿Conversamos sobre tu proyecto?"
			subtitle="Cuéntanos en qué está tu negocio y qué te gustaría lograr con tu sitio web."
			primaryLabel="Contactar"
			primaryHref={nav.contact}
			secondaryLabel="Ver servicios"
			secondaryHref={nav.services}
		/>
	</section>
</Layout>
