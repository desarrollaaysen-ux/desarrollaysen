---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import CTASection from '../../components/ui/CTASection.astro';

const nav = routes.es;

const values = [
	{ icon: 'M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.2-3.6A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z', title: 'Cercanía', text: 'Converso contigo en un lenguaje simple, sin tecnicismos innecesarios, en cada etapa del proyecto.' },
	{ icon: 'm4.5 12.75 6 6 9-13.5', title: 'Responsabilidad', text: 'Cumplo los plazos que acordamos y te mantengo al tanto del avance.' },
	{ icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z', title: 'Buenas prácticas técnicas', text: 'Aplico buenas prácticas de desarrollo y seguridad en cada sitio, como parte del estándar de calidad, no como un servicio aparte.' },
];
---

<Layout
	lang="es"
	route="about"
	title="Sobre mí"
	description="Conoce quién está detrás de Desarrolla y Sen y cómo trabajo en cada proyecto."
>
	<section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Sobre mí
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">
			[PENDIENTE DE REVISIÓN] Nombre / presentación breve
		</h1>

		<div class="mt-8 grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-start">
			<div class="aspect-square w-full max-w-xs rounded-2xl border border-dashed border-amber-300 bg-amber-50 flex items-center justify-center text-center p-6">
				<p class="text-sm text-amber-800">
					<span class="block font-semibold">[PENDIENTE DE REVISIÓN]</span>
					Foto de perfil (opcional) — 800×800px recomendado
				</p>
			</div>

			<div class="space-y-4 text-slate-600">
				<p class="rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900">
					<span class="font-semibold">[PENDIENTE DE REVISIÓN]</span> Historia breve:
					quién eres, cómo empezaste a desarrollar sitios web y qué te motiva a
					trabajar con pymes y emprendedores en Chile.
				</p>
				<p class="rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900">
					<span class="font-semibold">[PENDIENTE DE REVISIÓN]</span> Experiencia
					técnica relevante. Además del desarrollo web, tengo experiencia en
					ciberseguridad, algo que aplico como un plus de calidad técnica en
					cada sitio (buenas prácticas, headers de seguridad, HTTPS), no como
					el foco del servicio.
				</p>
			</div>
		</div>

		<div class="mt-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">Cómo trabajo</h2>
			<div class="mt-8 grid gap-6 sm:grid-cols-3">
				{values.map((value) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
							</svg>
						</div>
						<h3 class="mt-4 text-base font-semibold text-slate-900">{value.title}</h3>
						<p class="mt-2 text-sm text-slate-600">{value.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
		<CTASection
			title="¿Conversamos sobre tu proyecto?"
			subtitle="Cuéntame en qué está tu negocio y qué te gustaría lograr con tu sitio web."
			primaryLabel="Contactar"
			primaryHref={nav.contact}
			secondaryLabel="Ver servicios"
			secondaryHref={nav.services}
		/>
	</section>
</Layout>
