---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';

const features = [
	{
		icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z',
		title: '[PENDIENTE DE REVISIÓN] Seguridad desde el diseño',
		text: '[PENDIENTE DE REVISIÓN] 1-2 líneas sobre buenas prácticas de seguridad aplicadas por defecto.',
	},
	{
		icon: 'M13 3 4 14h6l-1 7 9-11h-6l1-7Z',
		title: '[PENDIENTE DE REVISIÓN] Rendimiento real',
		text: '[PENDIENTE DE REVISIÓN] 1-2 líneas sobre velocidad de carga y optimización.',
	},
	{
		icon: 'M4 6h16M4 12h16M4 18h10',
		title: '[PENDIENTE DE REVISIÓN] Comunicación clara',
		text: '[PENDIENTE DE REVISIÓN] 1-2 líneas sobre cómo trabajas con el cliente durante el proyecto.',
	},
];
---

<Layout
	lang="es"
	route="home"
	title="Inicio"
	description="Desarrollo de sitios web para pequeñas y medianas empresas en Chile. Sitios rápidos, seguros y pensados para tu negocio."
>
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,var(--color-brand-100),transparent_60%)]"></div>
		<div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
			<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
				Desarrollo web para pymes en Chile
			</span>
			<h1 class="mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
				[PENDIENTE DE REVISIÓN] Título principal del sitio
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-slate-600">
				[PENDIENTE DE REVISIÓN] Texto de introducción: quién eres, qué ofreces y a
				quién ayudas.
			</p>
			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href={routes.es.services}
					class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand-600/20 transition hover:bg-brand-700"
				>
					Ver servicios
				</a>
				<a
					href={routes.es.contact}
					class="rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-brand-300 hover:text-brand-700"
				>
					Contactar
				</a>
			</div>
		</div>
	</section>

	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">
				[PENDIENTE DE REVISIÓN] ¿Por qué trabajar conmigo?
			</h2>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					features.map((feature) => (
						<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
							<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
									<path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
								</svg>
							</div>
							<h3 class="mt-4 text-base font-semibold text-slate-900">{feature.title}</h3>
							<p class="mt-2 text-sm text-slate-600">{feature.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>
