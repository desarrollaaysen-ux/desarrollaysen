---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PricingCard from '../../components/ui/PricingCard.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { plansEn, maintenanceEn } from '../../data/plans';

const nav = routes.en;
const checkIcon = 'm4.5 12.75 6 6 9-13.5';

const faqs = [
	{ q: 'Which plan is right for me?', a: "If you're just starting out and need something simple, the Basic Plan is enough. If you want to showcase several services, have a contact form and some SEO, the Pro Plan is the better fit." },
	{ q: 'Can I switch plans later?', a: "Yes, a Basic Plan can be upgraded to a Pro Plan later on; we'll discuss the scope and any additional cost based on what's already built." },
	{ q: 'Is monthly maintenance required?', a: 'No. First-year hosting is already included in both plans; monthly maintenance is optional for those who prefer not to worry about backups, updates and content changes.' },
	{ q: 'How does payment work?', a: '[PENDIENTE DE REVISIÓN] Payment details are agreed directly with you before the project starts.' },
];
---

<Layout
	lang="en"
	route="services"
	title="Services"
	description="Web development plans for small businesses in Chile: basic site, professional site and monthly maintenance."
>
	<section class="mx-auto max-w-6xl px-6 py-16 text-center sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Clear plans, no fine print
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Services</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
			Plans built for small and medium businesses that need a solid web
			presence, without the hassle. Pick the one that matches where your
			business is today.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-8">
		<div class="grid gap-8 sm:grid-cols-2">
			{
				plansEn.map((plan) => (
					<PricingCard
						name={plan.name}
						subtitle={plan.subtitle}
						forWhom={plan.forWhom}
						features={plan.features}
						delivery={plan.delivery}
						highlight={plan.highlight}
						highlightLabel="Most popular"
						ctaLabel="Request this plan"
						ctaHref={nav.contact}
					/>
				))
			}
		</div>

		<article class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{maintenanceEn.name}</h2>
			<p class="mt-1 text-sm text-slate-500">{maintenanceEn.forWhom}</p>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					maintenanceEn.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-slate-700">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
								<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>
			<a href={nav.contact} class="mt-6 inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-brand-300 hover:bg-white hover:text-brand-700">
				Ask about maintenance
			</a>
		</article>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16">
		<blockquote class="rounded-2xl border-l-4 border-brand-600 bg-brand-50/60 p-8 text-lg leading-relaxed text-slate-700">
			<p>
				A site that works well, without complications. I take seriously the
				details many overlook: that your page loads fast, looks good on
				mobile, and is built with good security practices from day one. I
				don't promise magic — I promise a job well done, designed to give
				your business a solid online presence without headaches.
			</p>
		</blockquote>
	</section>

	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
			<SectionHeader eyebrow="FAQ" title="Questions about the plans" />
			<div class="mt-12 space-y-3">
				{faqs.map((faq) => <FAQItem question={faq.q} answer={faq.a} />)}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<CTASection
			title="Let's talk about your project"
			subtitle="Tell me what you need and I'll help you pick the right plan."
			primaryLabel="Get a quote"
			primaryHref={nav.contact}
			secondaryLabel="Back to home"
			secondaryHref={nav.home}
		/>
	</section>
</Layout>
