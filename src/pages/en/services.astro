---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import PricingCard from '../../components/ui/PricingCard.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { plansEn, hostingEn, maintenanceEn, paymentTermsEn } from '../../data/plans';

const nav = routes.en;
const checkIcon = 'm4.5 12.75 6 6 9-13.5';

const faqs = [
	{ q: 'Which plan is right for me?', a: "If you're just starting out and need something simple, the Essential Plan is enough. If you want to showcase several services, have a contact form and local SEO, the Complete Plan is the better fit. If you need online booking, a bilingual version or other extra features, check out the Advanced Plan." },
	{ q: 'Can I switch plans later?', a: "Yes, a plan can be upgraded to a higher one later on; we'll discuss the scope and any additional cost based on what's already built." },
	{ q: 'Is monthly maintenance required?', a: 'No. Domain and hosting are billed separately as an annual cost, and monthly maintenance is optional, for those who prefer not to worry about backups, updates and content changes.' },
	{ q: 'How much does each plan cost?', a: `The ${plansEn[0].name} starts ${plansEn[0].price.toLowerCase()}, the ${plansEn[1].name} starts ${plansEn[1].price.toLowerCase()}, and the ${plansEn[2].name} starts ${plansEn[2].price.toLowerCase()}, as a one-time payment. On top of that, ${hostingEn.name.toLowerCase()} starts ${hostingEn.price.toLowerCase()}, and optionally, ${maintenanceEn.name.toLowerCase()} starts ${maintenanceEn.price.toLowerCase()}. The final price depends on the scope, content, features and integrations required.` },
	{ q: 'How does payment work?', a: "Development is paid with a 50% deposit to reserve your project and get started, and the remaining 50% when the site is finished and published. The delivery timeline is counted from confirmation and payment of the deposit. Domain and hosting are billed separately as an annual cost, and monthly maintenance — if you hire it — is billed month to month." },
];
---

<Layout
	lang="en"
	route="services"
	title="Web Development Services & Plans"
	description="Web development plans for small businesses in Chile: essential site, complete site, advanced site and optional monthly maintenance."
>
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,var(--color-brand-100),transparent_60%)]"></div>
		<div class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-28">
			<span class="animate-fade-up inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
				Clear plans, no fine print
			</span>
			<h1 class="animate-fade-up mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl" style="animation-delay:60ms">
				Services
			</h1>
			<p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg text-slate-600" style="animation-delay:120ms">
				Plans built for small and medium businesses that need a solid web
				presence, without the hassle. Pick the one that matches where your
				business is today.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				plansEn.map((plan) => (
					<PricingCard
						name={plan.name}
						subtitle={plan.subtitle}
						price={plan.price}
						priceNote={plan.priceNote}
						forWhom={plan.forWhom}
						features={plan.features}
						delivery={plan.delivery}
						highlight={plan.highlight}
						highlightLabel="Most popular"
						ctaLabel="Request this plan"
						ctaHref={nav.contact}
					/>
				))
			}
		</div>

		<p class="mx-auto mt-6 max-w-4xl text-center text-sm text-slate-500">
			The client provides the text, images, logo, and business details needed for the project.
		</p>

		<article class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{hostingEn.name}</h2>
			<p class="mt-1 text-xl font-extrabold text-slate-900">{hostingEn.price}</p>
			<p class="mt-3 max-w-3xl text-sm text-slate-600">{hostingEn.description}</p>
		</article>

		<article class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">Payment terms</h2>
			<p class="mt-3 max-w-3xl text-sm text-slate-600">{paymentTermsEn}</p>
		</article>

		<article class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">{maintenanceEn.name}</h2>
			<p class="mt-1 text-xl font-extrabold text-slate-900">{maintenanceEn.price}</p>
			<p class="mt-1 text-sm text-slate-500">{maintenanceEn.forWhom}</p>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					maintenanceEn.features.map((feature) => (
						<li class="flex items-start gap-2.5 text-sm text-slate-700">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
								<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>
			<a href={nav.contact} class="mt-6 inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-brand-300 hover:bg-white hover:text-brand-700">
				Ask about maintenance
			</a>
		</article>

		<p class="mx-auto mt-8 max-w-4xl text-center text-sm text-slate-500">
			The final price depends on the project scope, amount of content, required features, and integrations. Projects with special requirements are quoted separately.
		</p>
	</section>

	<section class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
			<blockquote class="rounded-2xl border-l-4 border-brand-600 bg-white p-8 text-lg leading-relaxed text-slate-700 shadow-sm">
				<p>
					A site that works well, without complications. At Desarrolla Aysén we
					take seriously the details many overlook: that your page loads fast,
					looks good on mobile, and is built with good security practices from
					day one. We don't promise magic — we promise a job well done,
					designed to give your business a solid online presence without
					headaches.
				</p>
			</blockquote>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<SectionHeader eyebrow="FAQ" title="Questions about the plans" />
		<div class="mt-12 space-y-3">
			{faqs.map((faq) => <FAQItem question={faq.q} answer={faq.a} />)}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
		<CTASection
			title="Let's talk about your project"
			subtitle="Tell us what you need and we'll help you pick the right plan."
			primaryLabel="Get a quote"
			primaryHref={nav.contact}
			secondaryLabel="Back to home"
			secondaryHref={nav.home}
		/>
	</section>
</Layout>
