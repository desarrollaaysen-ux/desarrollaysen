---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ui/ContactForm.astro';

const items = [
	{ label: 'Contact email', icon: 'M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z' },
	{ label: 'WhatsApp / phone', icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372a1.5 1.5 0 0 0-1.14-1.456l-4.05-1.012a1.5 1.5 0 0 0-1.548.594l-.822 1.234a11.25 11.25 0 0 1-5.176-5.176l1.234-.822a1.5 1.5 0 0 0 .594-1.548L8.078 5.19a1.5 1.5 0 0 0-1.456-1.14H5.25A2.25 2.25 0 0 0 3 6.3v.45Z' },
	{ label: 'Availability', icon: 'M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z' },
];
---

<Layout
	lang="en"
	route="contact"
	title="Contact"
	description="Get in touch to talk about your website project."
>
	<section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			Contact
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Let's talk about your project</h1>
		<p class="mt-4 max-w-xl text-lg text-slate-600">
			Tell me where your business is at and what you'd like your website to
			achieve. I'll get back to you with a proposal that fits your needs.
		</p>

		<div class="mt-12 grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
			<ContactForm
				labels={{
					name: 'Name',
					email: 'Email',
					message: 'Tell me about your project',
					submit: 'Send message',
					note: "[PENDIENTE DE REVISIÓN] This form isn't connected to a delivery service yet. In the meantime, reach out directly through the contact options next to it.",
				}}
			/>

			<div class="space-y-4">
				{
					items.map((item) => (
						<div class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
									<path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
								</svg>
							</span>
							<span class="text-sm text-slate-700">
								<span class="font-semibold text-amber-700">[PENDIENTE DE REVISIÓN]</span> {item.label}
							</span>
						</div>
					))
				}

				<div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900">
					<span class="font-semibold">[PENDIENTE DE REVISIÓN]</span> Estimated
					response time.
				</div>
			</div>
		</div>
	</section>
</Layout>
