---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../i18n/ui';
import CTASection from '../../components/ui/CTASection.astro';

const nav = routes.en;

const values = [
	{ icon: 'M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.2-3.6A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z', title: 'Clear communication', text: 'We talk with you in plain language, no unnecessary jargon, at every stage of the project.' },
	{ icon: 'm4.5 12.75 6 6 9-13.5', title: 'Close support', text: "We support every project from start to finish, keeping you updated on progress." },
	{ icon: 'M12 3 4 6.5v5.6c0 4.9 3.4 9.4 8 10.4 4.6-1 8-5.5 8-10.4V6.5L12 3Z', title: 'Solid technical practices', text: 'Projects are built considering good security, performance and privacy practices.' },
];

const services = [
	'Professional website development',
	'Pages for small businesses and entrepreneurs',
	'Landing pages',
	'Corporate sites',
	'Digital portfolios',
	'Product or service catalogs',
];
---

<Layout
	lang="en"
	route="about"
	title="About us"
	description="Meet Desarrolla Aysén: website development for small businesses and entrepreneurs in Chile."
>
	<section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			About us
		</span>
		<h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900">Desarrolla Aysén</h1>

		<div class="mt-8 space-y-5 text-lg text-slate-600">
			<p>
				At Desarrolla Aysén, we help small businesses and entrepreneurs
				strengthen their digital presence through modern, fast websites
				tailored to their goals.
			</p>
			<p>
				Our approach combines design, technology and close support to build
				clear, functional, easy-to-use pages designed to build trust and make
				it easier to connect with new customers.
			</p>
		</div>

		<div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
			<h2 class="text-xl font-bold text-slate-900">How we work</h2>
			<p class="mt-4 text-slate-600">
				Desarrolla Aysén exists to bring professional digital solutions to
				businesses and entrepreneurs who need to improve their presence
				online. We build fast, modern, functional websites, taking into
				account each business's characteristics and commercial goals.
			</p>
			<p class="mt-4 text-slate-600">
				We believe in a clear, direct and close service, where every client
				can understand the process, take part in decisions, and get a
				solution tailored to their needs.
			</p>
		</div>

		<div class="mt-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">What we do</h2>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2">
				{services.map((service) => (
					<li class="flex items-start gap-2.5 text-sm text-slate-700">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
							<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
						</svg>
						{service}
					</li>
				))}
			</ul>
		</div>

		<div class="mt-16">
			<h2 class="text-2xl font-bold tracking-tight text-slate-900">Our values</h2>
			<div class="mt-8 grid gap-6 sm:grid-cols-3">
				{values.map((value) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
						<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d={value.icon} />
							</svg>
						</div>
						<h3 class="mt-4 text-base font-semibold text-slate-900">{value.title}</h3>
						<p class="mt-2 text-sm text-slate-600">{value.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
		<CTASection
			title="Let's talk about your project"
			subtitle="Tell us where your business is at and what you'd like your website to achieve."
			primaryLabel="Get in touch"
			primaryHref={nav.contact}
			secondaryLabel="View services"
			secondaryHref={nav.services}
		/>
	</section>
</Layout>
