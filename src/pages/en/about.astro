---
import Layout from '../../layouts/Layout.astro';

const pending = [
	'Short background, experience and way of working.',
	'Photo or personal introduction (optional).',
	'Values / how I work with small-business clients.',
];
---

<Layout
	lang="en"
	route="about"
	title="About"
	description="Learn who's behind Desarrolla y Sen and how I work on every project."
>
	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<h1 class="text-4xl font-extrabold tracking-tight text-slate-900">About</h1>

		<div class="mt-10 space-y-4">
			{
				pending.map((item) => (
					<div class="rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900">
						<span class="font-semibold">[PENDIENTE DE REVISIÓN]</span> {item}
					</div>
				))
			}
		</div>
	</section>
</Layout>
