---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blogEn', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout lang="en" route="blogPost" title={post.data.title} description={post.data.description}>
	<article class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{post.data.title}</h1>
		<time datetime={post.data.pubDate.toISOString()} class="mt-3 block text-sm font-medium text-slate-400">
			{post.data.pubDate.toLocaleDateString('en-US')}
		</time>
		<div class="prose mt-10">
			<Content />
		</div>
	</article>
</Layout>
