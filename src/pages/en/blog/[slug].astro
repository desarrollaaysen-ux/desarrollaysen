---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { routes } from '../../../i18n/ui';

export async function getStaticPaths() {
	const posts = await getCollection('blogEn', ({ data }) => !data.draft);

	// Solo se ofrece hreflang hacia un post en español si ese post
	// efectivamente existe y está publicado (nunca hacia un borrador o un
	// slug que no corresponda a ninguna página real).
	const publishedEsPosts = await getCollection('blogEs', ({ data }) => !data.draft);
	const publishedEsIds = new Set(publishedEsPosts.map((p) => p.id));

	return posts.map((post) => {
		const translationSlug = post.data.translationSlug;
		const translatedPath =
			translationSlug && publishedEsIds.has(translationSlug) ? `/es/blog/${translationSlug}/` : undefined;

		return {
			params: { slug: post.id },
			props: { post, allPosts: posts, translatedPath },
		};
	});
}

const { post, allPosts, translatedPath } = Astro.props;
const { Content } = await render(post);

const related = allPosts
	.filter((p) => p.id !== post.id)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout lang="en" route="blogPost" title={post.data.title} description={post.data.description} translatedPath={translatedPath}>
	<article class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<a href={routes.en.blog} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
				<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
			</svg>
			Back to blog
		</a>

		<h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{post.data.title}</h1>
		<time datetime={post.data.pubDate.toISOString()} class="mt-3 block text-sm font-medium text-slate-400">
			{post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
		</time>
		<div class="prose mt-10">
			<Content />
		</div>
	</article>

	{related.length > 0 && (
		<section class="border-t border-slate-100 bg-slate-50">
			<div class="mx-auto max-w-3xl px-6 py-16">
				<h2 class="text-lg font-bold text-slate-900">Related articles</h2>
				<ul class="mt-6 grid gap-4 sm:grid-cols-3">
					{related.map((r) => (
						<li>
							<a href={`/en/blog/${r.id}/`} class="block rounded-xl border border-slate-200 bg-white p-4 text-sm font-medium text-slate-800 shadow-sm hover:border-brand-300 hover:text-brand-700">
								{r.data.title}
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}
</Layout>
