---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
	lang="en"
	route="blog"
	title="Blog"
	description="Articles about web development, best practices and security for small businesses."
>
	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
		<h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Blog</h1>

		{
			posts.length === 0 && (
				<p class="mt-6 rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900">
					<span class="font-semibold">[PENDIENTE DE REVISIÓN]</span> No published articles yet.
				</p>
			)
		}

		<ul class="mt-10 space-y-6">
			{
				posts.map((post) => (
					<li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-300 hover:shadow-md">
						<a href={`/en/blog/${post.id}/`} class="text-lg font-semibold text-slate-900 hover:text-brand-700">
							{post.data.title}
						</a>
						<p class="mt-2 text-sm text-slate-600">{post.data.description}</p>
						<time datetime={post.data.pubDate.toISOString()} class="mt-3 block text-xs font-medium text-slate-400">
							{post.data.pubDate.toLocaleDateString('en-US')}
						</time>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
