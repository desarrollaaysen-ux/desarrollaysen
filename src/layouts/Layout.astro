---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, type Lang, type RouteKey } from '../i18n/ui';
import '../styles/global.css';

interface Props {
	lang: Lang;
	route: RouteKey;
	title: string;
	description: string;
	/** Ruta absoluta a una imagen OG, ej: "/og-image.jpg". Opcional. */
	image?: string;
	/**
	 * Solo aplica cuando route === 'blogPost'. Ruta (path) de la versión
	 * traducida de ESTE post específico, ej. "/en/blog/mi-post/". Debe venir
	 * ya validada por la página que la pasa (que el post traducido exista y
	 * esté publicado) — Layout no puede saberlo por sí mismo porque cada
	 * artículo tiene un slug propio, no un patrón fijo como el resto del
	 * sitio. Si no se pasa, la página no emite hreflang (nunca se inventa
	 * una alternativa de idioma).
	 */
	translatedPath?: string;
}

const { lang, route, title, description, image, translatedPath } = Astro.props;

const siteName = 'Desarrolla Aysén';
const fullTitle = `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;
const ogLocale = lang === 'es' ? 'es_CL' : 'en_US';

// --- hreflang ---
// Páginas estáticas (todo route salvo 'blogPost'): el par ES/EN ya existe,
// completo y correcto, en el mapa central `routes` (src/i18n/ui.ts) — no se
// genera reemplazando texto en la URL actual, se toma el valor explícito ya
// definido para cada idioma.
// Posts de blog ('blogPost'): dependen enteramente de `translatedPath`, que
// ya viene validado desde la página (ver src/pages/{es,en}/blog/[slug].astro).
// Si no hay contraparte real, ambas variables quedan `undefined` y no se
// emite ningún hreflang (nunca una alternativa falsa o hacia un borrador).
let esPath: string | undefined;
let enPath: string | undefined;

if (route !== 'blogPost') {
	esPath = routes.es[route];
	enPath = routes.en[route];
} else if (translatedPath) {
	esPath = lang === 'es' ? Astro.url.pathname : translatedPath;
	enPath = lang === 'en' ? Astro.url.pathname : translatedPath;
}

const esAlternateURL = esPath ? new URL(esPath, Astro.site) : undefined;
const enAlternateURL = enPath ? new URL(enPath, Astro.site) : undefined;

// --- JSON-LD: Organization ---
// Se emite únicamente en las portadas (route === 'home', es decir /es/ y
// /en/). Ambos idiomas representan la misma organización y comparten el
// mismo @id estable. No se incluye WebSite en esta etapa (ver Etapa 3,
// ajuste 2): Google retiró el sitelinks search box en noviembre de 2024,
// y las portadas no son la raíz del dominio, así que WebSite se evalúa
// por separado más adelante.
const organizationDescription =
	lang === 'es'
		? 'Desarrollo de sitios web para pequeñas y medianas empresas en Chile. Sitios rápidos, seguros y pensados para tu negocio.'
		: 'Web development for small and medium businesses in Chile. Fast, secure sites built for your business.';

const organizationSchema =
	route === 'home'
		? {
				'@context': 'https://schema.org',
				'@type': 'Organization',
				'@id': 'https://desarrollaysen.com/#organization',
				name: 'Desarrolla Aysén',
				url: 'https://desarrollaysen.com/',
				description: organizationDescription,
				email: 'desarrollaaysen@gmail.com',
				areaServed: {
					'@type': 'Country',
					name: 'Chile',
				},
			}
		: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- hreflang: solo se emite cuando existe realmente el par ES/EN
		     (páginas estáticas siempre; posts de blog solo con traducción
		     publicada). x-default apunta a la versión en español, que es la
		     que sirve "/" por defecto sin detección de navegador. -->
		{esAlternateURL && enAlternateURL && (
			<>
				<link rel="alternate" hreflang="es-CL" href={esAlternateURL} />
				<link rel="alternate" hreflang="en" href={enAlternateURL} />
				<link rel="alternate" hreflang="x-default" href={esAlternateURL} />
			</>
		)}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content={ogLocale} />
		{ogImageURL && <meta property="og:image" content={ogImageURL} />}

		<!-- Twitter -->
		<meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

		<!-- JSON-LD: Organization (solo en portadas, ver Etapa 3 SEO) -->
		{organizationSchema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)}></script>
		)}
	</head>
	<body class="flex min-h-screen flex-col bg-white font-sans text-slate-900 antialiased">
		<Header lang={lang} route={route} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
