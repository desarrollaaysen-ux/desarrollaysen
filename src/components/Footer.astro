---
import type { Lang } from '../i18n/ui';
import { routes } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = routes[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-900 text-slate-300">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:flex-row sm:justify-between">
		<div class="max-w-sm">
			<div class="flex items-center gap-2 text-base font-bold text-white">
				<span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 text-xs font-black text-white">
					DS
				</span>
				Desarrolla y Sen
			</div>
			<p class="mt-3 text-sm text-slate-400">{t('footer.tagline')}</p>
		</div>

		<nav class="flex flex-wrap gap-x-8 gap-y-2 text-sm" aria-label="Footer navigation">
			<a href={nav.home} class="hover:text-white">{t('nav.home')}</a>
			<a href={nav.services} class="hover:text-white">{t('nav.services')}</a>
			<a href={nav.about} class="hover:text-white">{t('nav.about')}</a>
			<a href={nav.blog} class="hover:text-white">{t('nav.blog')}</a>
			<a href={nav.contact} class="hover:text-white">{t('nav.contact')}</a>
		</nav>
	</div>

	<div class="border-t border-slate-800">
		<p class="mx-auto max-w-6xl px-6 py-5 text-xs text-slate-500">
			&copy; {year} Desarrolla y Sen &mdash; {t('footer.rights')}
		</p>
	</div>
</footer>
