---
import IconWrapper from './IconWrapper.astro';

interface Props {
	icon: string;
	title: string;
	text: string;
	benefit: string;
	ctaLabel: string;
	ctaHref: string;
}

const { icon, title, text, benefit, ctaLabel, ctaHref } = Astro.props;
---

<article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg">
	<IconWrapper path={icon} size="lg" />
	<h3 class="mt-5 text-lg font-bold text-slate-900">{title}</h3>
	<p class="mt-2 text-sm text-slate-600">{text}</p>
	<p class="mt-4 text-sm font-medium text-brand-700">{benefit}</p>
	<a
		href={ctaHref}
		class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition group-hover:gap-2.5"
	>
		{ctaLabel}
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
			<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
		</svg>
	</a>
</article>
