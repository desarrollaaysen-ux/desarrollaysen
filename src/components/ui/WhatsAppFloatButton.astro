---
// Botón flotante y discreto de WhatsApp, visible en todo el sitio excepto
// en las páginas de Contacto (que ya tienen una opción de WhatsApp visible
// y suficiente en su propio contenido). Reutiliza getWhatsAppHref para no
// duplicar el número ni construir un link manualmente.
import { getWhatsAppHref } from '../../data/contact';

interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;
const href = getWhatsAppHref(lang);

const ariaLabel = lang === 'es' ? 'Consultar por WhatsApp' : 'Contact us on WhatsApp';
const bubbleText = lang === 'es' ? '¿Tienes alguna consulta?' : 'Have a question?';
---

<div class="wa-float">
	<a href={href} target="_blank" rel="noopener noreferrer" aria-label={ariaLabel} class="wa-float__button">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="wa-float__icon" aria-hidden="true">
			<path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.24-1.37A9.96 9.96 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.2c-1.6 0-3.1-.44-4.38-1.2l-.31-.19-3.1.82.83-3.02-.2-.31A8.17 8.17 0 0 1 3.84 12c0-4.53 3.68-8.2 8.2-8.2 4.53 0 8.2 3.67 8.2 8.2 0 4.52-3.67 8.2-8.2 8.2Zm4.48-6.13c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.78.95-.14.16-.29.18-.53.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.35-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.29.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42-.14-.01-.3-.01-.46-.01-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28Z" />
		</svg>
	</a>
	<span class="wa-float__bubble" aria-hidden="true">{bubbleText}</span>
</div>

<style>
	/* Contenedor fijo: no participa del flujo normal del documento, por lo
	   que no puede generar CLS ni desplazar contenido. Se reserva un margen
	   de las orillas de la pantalla y respeta las áreas seguras en iOS. */
	.wa-float {
		position: fixed;
		right: calc(1.1rem + env(safe-area-inset-right, 0px));
		bottom: calc(1.1rem + env(safe-area-inset-bottom, 0px));
		z-index: 40;
		pointer-events: none;
	}

	.wa-float__button {
		pointer-events: auto;
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 9999px;
		background-color: #25d366;
		border: 2px solid rgba(255, 255, 255, 0.92);
		box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
		color: #ffffff;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.wa-float__button:hover,
	.wa-float__button:focus-visible {
		transform: scale(1.06);
		box-shadow: 0 8px 22px rgba(15, 23, 42, 0.28);
	}

	.wa-float__button:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
	}

	.wa-float__icon {
		width: 1.65rem;
		height: 1.65rem;
	}

	/* Burbuja de invitación: puramente decorativa (aria-hidden), oculta a
	   lectores de pantalla porque el aria-label del enlace ya describe el
	   propósito completo. Aparece brevemente con una animación de una sola
	   pasada y vuelve a estar disponible con hover/focus. */
	.wa-float__bubble {
		pointer-events: none;
		position: absolute;
		right: calc(100% + 0.75rem);
		bottom: 0.55rem;
		max-width: 12.5rem;
		white-space: nowrap;
		background-color: #ffffff;
		color: #0f172a;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		padding: 0.5rem 0.85rem;
		border-radius: 0.75rem;
		border: 1px solid #e2e8f0;
		box-shadow: 0 4px 14px rgba(15, 23, 42, 0.14);
		opacity: 0;
		animation: wa-invite 12s ease-in-out 1 both;
	}

	@keyframes wa-invite {
		0%,
		33% {
			opacity: 0;
		}
		36%,
		63% {
			opacity: 1;
		}
		68%,
		100% {
			opacity: 0;
		}
	}

	/* Reaparece con hover o foco por teclado, sin depender de la animación
	   automática (que puede ya haber terminado). */
	.wa-float:hover .wa-float__bubble,
	.wa-float:focus-within .wa-float__bubble {
		animation: none;
		opacity: 1;
	}

	/* La regla global en src/styles/global.css ya reduce toda
	   animation-duration/transition-duration a ~0 bajo prefers-reduced-motion,
	   lo que neutraliza la aparición automática de la burbuja sin necesidad
	   de duplicar esa lógica acá. El botón permanece funcional y la burbuja
	   sigue disponible vía hover/focus (transición casi instantánea, sin
	   desplazamientos ni escalados animados). */
</style>
