---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
	class?: string;
}

const { eyebrow, title, subtitle, align = 'center', class: extraClass = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignClass} ${extraClass}`}>
	{eyebrow && (
		<span class="inline-block rounded-full bg-brand-50 px-4 py-1 text-sm font-semibold text-brand-700">
			{eyebrow}
		</span>
	)}
	<h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>
	{subtitle && <p class="mt-4 text-lg text-slate-600">{subtitle}</p>}
</div>
