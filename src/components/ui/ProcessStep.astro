---
interface Props {
	number: number;
	title: string;
	text: string;
	isLast?: boolean;
}

const { number, title, text, isLast = false } = Astro.props;
---

<div class="relative flex gap-5">
	<div class="flex flex-col items-center">
		<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
			{number}
		</div>
		{!isLast && <div class="mt-2 w-px flex-1 bg-slate-200" aria-hidden="true"></div>}
	</div>
	<div class="pb-10">
		<h3 class="text-base font-semibold text-slate-900">{title}</h3>
		<p class="mt-1.5 text-sm text-slate-600">{text}</p>
	</div>
</div>
