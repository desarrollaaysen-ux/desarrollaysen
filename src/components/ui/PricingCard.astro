---
interface Props {
	name: string;
	subtitle: string;
	forWhom: string;
	features: string[];
	delivery: string;
	ctaLabel: string;
	ctaHref: string;
	highlightLabel?: string;
	highlight?: boolean;
}

const { name, subtitle, forWhom, features, delivery, ctaLabel, ctaHref, highlightLabel, highlight = false } = Astro.props;
const checkIcon = 'm4.5 12.75 6 6 9-13.5';
---

<article
	class:list={[
		'relative flex flex-col rounded-2xl border p-8',
		highlight
			? 'border-brand-600 bg-white shadow-xl shadow-brand-600/10 ring-1 ring-brand-600 lg:scale-[1.03]'
			: 'border-slate-200 bg-white shadow-sm',
	]}
>
	{highlight && highlightLabel && (
		<span class="absolute -top-3 left-8 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
			{highlightLabel}
		</span>
	)}

	<h3 class="text-xl font-bold text-slate-900">{name}</h3>
	<p class="mt-1 text-sm font-medium text-brand-600">{subtitle}</p>
	<p class="mt-3 text-sm text-slate-500">{forWhom}</p>

	<ul class="mt-6 flex-1 space-y-3">
		{features.map((feature) => (
			<li class="flex items-start gap-2.5 text-sm text-slate-700">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600">
					<path stroke-linecap="round" stroke-linejoin="round" d={checkIcon} />
				</svg>
				{feature}
			</li>
		))}
	</ul>

	<p class="mt-6 border-t border-slate-100 pt-4 text-sm font-semibold text-slate-900">{delivery}</p>

	<a
		href={ctaHref}
		class:list={[
			'mt-6 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition',
			highlight
				? 'bg-brand-600 text-white shadow-md shadow-brand-600/20 hover:bg-brand-700'
				: 'border border-slate-300 text-slate-700 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700',
		]}
	>
		{ctaLabel}
	</a>
</article>
