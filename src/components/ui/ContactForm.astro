---
// Formulario visual. Todavía no está conectado a ningún servicio de envío
// (Formspree, Cloudflare Turnstile + endpoint propio, etc.) — eso requiere
// una decisión y, probablemente, sumar un dominio a la CSP, así que se deja
// preparado visualmente hasta que se defina e implemente ese backend.
interface Props {
	labels: {
		name: string;
		email: string;
		message: string;
		submit: string;
		note: string;
	};
}

const { labels } = Astro.props;
---

<form class="space-y-5 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
	<div>
		<label for="name" class="block text-sm font-medium text-slate-700">{labels.name}</label>
		<input
			type="text"
			id="name"
			name="name"
			autocomplete="name"
			class="mt-1.5 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-slate-900 shadow-sm transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
		/>
	</div>

	<div>
		<label for="email" class="block text-sm font-medium text-slate-700">{labels.email}</label>
		<input
			type="email"
			id="email"
			name="email"
			autocomplete="email"
			class="mt-1.5 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-slate-900 shadow-sm transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
		/>
	</div>

	<div>
		<label for="message" class="block text-sm font-medium text-slate-700">{labels.message}</label>
		<textarea
			id="message"
			name="message"
			rows="4"
			class="mt-1.5 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm text-slate-900 shadow-sm transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
		></textarea>
	</div>

	<button
		type="submit"
		disabled
		aria-disabled="true"
		class="inline-flex w-full items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white opacity-60 shadow-md shadow-brand-600/20 sm:w-auto"
	>
		{labels.submit}
	</button>

	<p class="text-xs text-slate-400">{labels.note}</p>
</form>
