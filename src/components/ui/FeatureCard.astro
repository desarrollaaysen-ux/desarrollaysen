---
import IconWrapper from './IconWrapper.astro';

interface Props {
	icon: string;
	title: string;
	text: string;
}

const { icon, title, text } = Astro.props;
---

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
	<IconWrapper path={icon} />
	<h3 class="mt-4 text-base font-semibold text-slate-900">{title}</h3>
	<p class="mt-2 text-sm text-slate-600">{text}</p>
</div>
